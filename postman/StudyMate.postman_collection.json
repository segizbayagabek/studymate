                  "const r = pm.response.json();",
                  "pm.test(\"Pending with full score\", () => {",
                  "    pm.expect(r.status).to.eql(\"PENDING\");",
                  "    pm.expect(r.score).to.eql(100);",
                  "    pm.expect(r.breakdown).to.have.keys(\"subject\", \"time\", \"level\", \"preferences\");",
                  "});"
