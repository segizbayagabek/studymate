    {
      "name": "1. Study groups",
      "item": [
        {
          "name": "Create group",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"groupId\", pm.response.json().id);",
                  "const g = pm.response.json();",
                  "pm.test(\"Group is open with free seats\", () => {",
                  "    pm.expect(g.status).to.eql(\"OPEN\");",
                  "    pm.expect(g.seatsLeft).to.eql(g.groupSize - 1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{organizerId}}/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{organizerId}}",
                "groups"
              ]
            },
            "description": "groupSize includes the organizer. Places: LIBRARY, CANTEEN, TOP_FLOOR. Levels: BEGINNER, INTERMEDIATE, ADVANCED. Preferences: QUIET_WORK, TALKATIVE, MIXED_GROUP, WOMEN_ONLY, MEN_ONLY, SAME_YEAR, ANY_LEVEL.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Calculus II — practice set together\",\n  \"description\": \"Work through the practice set, then explain solutions out loud to each other.\",\n  \"subjectName\": \"Calculus II\",\n  \"courseCode\": \"MATH 161\",\n  \"place\": \"LIBRARY\",\n  \"exactSpot\": \"2nd floor, table 14\",\n  \"meetingDate\": \"{{meetingDate}}\",\n  \"startTime\": \"14:00\",\n  \"endTime\": \"16:00\",\n  \"level\": \"INTERMEDIATE\",\n  \"preferences\": [\n    \"QUIET_WORK\"\n  ],\n  \"groupSize\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Browse open groups",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Exact spot is hidden in the public list\", () => {",
                  "    pm.response.json().forEach(g => pm.expect(g.exactSpot).to.be.null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/groups?courseCode=MATH 161",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "groups"
              ],
              "query": [
                {
                  "key": "courseCode",
                  "value": "MATH 161"
                },
                {
                  "key": "place",
                  "value": "LIBRARY",
                  "disabled": true
                },
                {
                  "key": "level",
                  "value": "INTERMEDIATE",
                  "disabled": true
                },
                {
                  "key": "dateFrom",
                  "value": "{{meetingDate}}",
                  "disabled": true
                },
                {
                  "key": "dateTo",
                  "value": "{{meetingDate}}",
                  "disabled": true
                }
              ]
            },
            "description": "Only OPEN groups from today on. All filters are optional; enable them in the Params tab."
          }
        },
        {
          "name": "My organized groups",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
