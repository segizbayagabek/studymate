# Copy this file to .env and fill it in. .env is git-ignored, so secrets stay on your computer.

# Gmail account that sends the login codes. GMAIL_APP_PASSWORD is a Gmail "App password",
# not your normal Gmail password. Without these, the login page can't send codes.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Database login used by the db and backend containers (optional, defaults to studymate/studymate)
# DB_USER=studymate
# DB_PASSWORD=studymate

# Ports on your computer (optional). Change one if "port is already allocated" appears.
# FRONTEND_PORT=3000
# BACKEND_PORT=8080
# DB_PORT=5434
